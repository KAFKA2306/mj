{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kafka2306.github.io/mj/schemas/training-pack.schema.json",
  "title": "Mahjong Training Pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "focus", "difficulty", "version", "scenarios"],
  "properties": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "title": {"type": "string", "minLength": 1},
    "focus": {"type": "string", "minLength": 1},
    "difficulty": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sourceScenarioType", "prompt", "context", "choices", "answerPolicy"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "sourceScenarioType": {"type": "string", "minLength": 1},
          "prompt": {"type": "string", "minLength": 1},
          "context": {"type": "string", "minLength": 1},
          "choices": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "answerPolicy": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["mode", "recommended", "acceptable"],
                "properties": {
                  "mode": {"const": "SCORABLE"},
                  "recommended": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
                  "acceptable": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["mode", "recommended", "acceptable"],
                "properties": {
                  "mode": {"const": "REVIEW_REQUIRED"},
                  "recommended": {"type": "array", "maxItems": 0},
                  "acceptable": {"type": "array", "maxItems": 0}
                }
              }
            ]
          }
        }
      }
    }
  }
}
